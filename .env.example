# ANTHROPIC_API_KEY is required for the default VLM provider (Anthropic Claude).
# Do NOT put it in this file, and do not export it from ~/.zshrc (every
# process started from the shell could then read it). Store it in the macOS
# Keychain:
#
#   security add-generic-password -s ANTHROPIC_API_KEY -a "$USER" -w
#
# `make run-backend` and `make benchmark` read it from the Keychain for that
# one process. Off macOS, set it in the environment of the backend process.
#
# `make dev-backend` needs no key: it runs the mock VLM provider on a seeded
# throwaway data dir (backend/.dev-data) and sets STUDIOUS_DATA_DIR,
# STUDIOUS_VLM_PROVIDER and the key variables itself, overriding this file.

# Where uploaded docs, page images, transcriptions, and jobs live.
# Defaults to ./data if unset. This is the real data dir that
# `make run-backend` uses; `make dev-backend` overrides it.
STUDIOUS_DATA_DIR=./data

# Which VLM provider backs the app: "anthropic" (default) or "mock" (canned
# output, no key, no network; what `make dev-backend` and the E2E suite use).
# STUDIOUS_VLM_PROVIDER=anthropic

# Optional: override the path to the tesseract binary if not on PATH.
# Linux:  TESSERACT_CMD=/usr/bin/tesseract
# macOS:  TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Optional: DPI used to rasterize PDF pages on upload. Default: 300.
# Higher = sharper text but larger files and slower upload (roughly quadratic).
# STUDIOUS_PDF_RENDER_DPI=300

# Optional: backend log level. One of DEBUG, INFO, WARNING, ERROR. Default: INFO.
# Use DEBUG to surface per-page transcription progress and other verbose lines
# during feature work; leave at INFO for benchmark runs.
# STUDIOUS_LOG_LEVEL=INFO
