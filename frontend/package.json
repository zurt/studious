{
  "name": "studious-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome lint --error-on-warnings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "marked": "^18.1.3"
  },
  "overrides": {
    "vitest": {
      "vite": {
        "esbuild": "0.28.0"
      }
    }
  }
}
