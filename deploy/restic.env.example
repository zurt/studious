# Template for /etc/studious/restic.env on the droplet, read by
# studious-backup.sh and studious-restore-test.sh. provision.sh installs it
# there once, mode 0600 (root only), and never overwrites it. The scripts
# source it with bash, so a value with spaces needs quotes.
#
# provision.sh also makes the password file (a random passphrase). Copy that
# passphrase into the password manager as soon as you have run `restic init`:
# without it the backups cannot be read, including after the droplet is gone.

# The bucket from docs/deploy.md step 1. restic's B2 syntax: b2:<bucket>:<path>.
RESTIC_REPOSITORY="b2:<bucket-name>:studious"
RESTIC_PASSWORD_FILE=/etc/studious/restic-password

# An application key restricted to that one bucket, not the master key.
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
