# Template for /etc/studious/env on the droplet. docker compose reads it as
# the container's environment (deploy/compose.yml, `env_file`). provision.sh
# installs this file there once, mode 0600, and never overwrites it.
#
# Format: KEY=value, one per line, no quotes (compose keeps them literally),
# no spaces around "=". Lines starting with # are comments. No real values
# belong in this file in the repo.
#
# The image already sets STUDIOUS_DATA_DIR=/data and STUDIOUS_STATIC_DIR; do
# not set them here.

# --- Required ----------------------------------------------------------------

# The production key, with its own spend cap. On the Mac its Keychain item is
# ANTHROPIC_API_KEY_PROD.
ANTHROPIC_API_KEY=

# Leave this at anthropic. `mock` runs with no key and answers with canned text.
STUDIOUS_VLM_PROVIDER=anthropic

# --- Optional ----------------------------------------------------------------

# WaniKani sync. Leave empty to turn it off.
WANIKANI_API_TOKEN=

# Logs are JSON; read them with `docker logs studious`.
#STUDIOUS_LOG_LEVEL=INFO

# Upload limits (0 turns one off). Defaults: 300 MB and 1500 pages. Rendered
# pages are the bigger cost on a small disk.
#STUDIOUS_UPLOAD_MAX_MB=300
#STUDIOUS_UPLOAD_MAX_PAGES=1500

# --- Things that stay on the Mac, reached over the tailnet -------------------
# docs/hosting.md, "New homes", says how to publish each one on the Mac with
# `tailscale serve`. Replace <mac-tailnet-name> with the Mac's MagicDNS name
# (see `tailscale status` on the Mac). Uncomment when the routes exist.

# Card audio: the Mac's `say` voices, through the helper (`make say-helper`).
#STUDIOUS_TTS_ENGINE=say_remote
#STUDIOUS_SAY_HELPER_URL=http://<mac-tailnet-name>:8766
# Make clips in the background when items are harvested. 0 turns it off.
#STUDIOUS_TTS_PREGENERATE=1

# Anki, through AnkiConnect on the Mac (Anki must be open there).
#ANKI_CONNECT_URL=http://<mac-tailnet-name>:8765
#ANKI_PUSH_DECK=Studious
#ANKI_PUSH_NOTE_TYPE=Kaishi 1.5k
